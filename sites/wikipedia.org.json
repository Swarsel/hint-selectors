{
  "$schema": "../schema/site.schema.json",
  "domain": "wikipedia.org",
  "rules": [
    {
      "match": ["*://*.wikipedia.org/w/index.php*"],
      "sets": {
        "primary": ".mw-search-result-heading a"
      }
    },
    {
      "match": ["*://*.wikipedia.org/wiki/Category:*"],
      "sets": {
        "primary": "#mw-pages a, #mw-subcategories a"
      }
    }
  ]
}
